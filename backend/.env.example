# matching-ops-api 환경변수

# 자란다 read replica MySQL (asyncmy driver)
# 비밀번호는 vibe-cs와 동일 — team-pulse-bot/.env.cloud 참고 (2026-04-20 fynn 변경)
JARANDA_REPLICA_URL=mysql+asyncmy://siahn:CHANGE_ME@10.6.16.6:3306/jaranda

# CORS — 페이지 도메인 (쉼표 구분)
ALLOWED_ORIGINS=https://matching-ops-266295307740.asia-northeast3.run.app,http://localhost:8000

# Google OAuth — @jaranda.kr 만 허용
# GCP 콘솔 > APIs & Services > Credentials > OAuth 2.0 Client ID (Web app)
# Authorized JS origins 에 위 ALLOWED_ORIGINS 도메인 추가 필요
GOOGLE_CLIENT_ID=
AUTH_REQUIRED=true
OTP_SECRET_KEY=  # random 32 bytes hex 권장
OTP_SESSION_HOURS=8

LOG_LEVEL=INFO
